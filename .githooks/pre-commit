#!/bin/sh
# Block .mp4 files over 10 MB (raw originals). Re-encode with ffmpeg instead.
for f in $(git diff --cached --name-only --diff-filter=AM | grep -i '\.mp4$'); do
  s=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$s" -gt 10485760 ]; then echo "pre-commit: $f is over 10 MB — refusing to commit raw video." >&2; exit 1; fi
done
